# QuickBite frontend runtime settings
# Copy this file to .env and keep the real values local.

API_URL=http://localhost:8080/api/v1
WS_URL=http://localhost:8080/ws
AUTH_URL=http://localhost:8081

# OAuth routes used by the login screen
GOOGLE_OAUTH_URL=/oauth2/authorization/google
GITHUB_OAUTH_URL=/oauth2/authorization/github
